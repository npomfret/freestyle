{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": ["Bash(*)", "WebSearch", "WebFetch", "mcp__gitnexus"],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git checkout --:*)",
      "Bash(rm -rf:*)",
      "Bash(npm run deploy:*)",
      "Bash(npm run migrate:*)",
      "Bash(npm run discover:*)",
      "Bash(npm run add-url:*)",
      "Bash(npm run repair:*)",
      "Bash(npm run validity-check:*)",
      "Bash(npm run embed:*)",
      "Bash(npm run re-embed:*)",
      "Bash(psql:*)",
      "Bash(ssh root@fsd.snowmonkey.co.uk:*)",
      "Bash(docker compose -f docker-compose.production.yml:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "git fetch *",
      "git pull *",
      "git push *",
      "git ls-remote *",
      "git clone *",
      "gh *",
      "ssh *",
      "scp *",
      "rsync *",
      "npm run deploy*"
    ],
    "network": {
      "allowedDomains": ["*"],
      "allowLocalBinding": true,
      "allowAllUnixSockets": true
    },
    "filesystem": {
      "allowWrite": [
        "~/.npm",
        "~/.cache",
        "~/Library/Caches",
        "~/Library/Developer/Xcode/DerivedData",
        "~/.gitnexus",
        "/var/folders"
      ]
    }
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "enabledPlugins": {
    "task-files@npomfret": true
  },
  "enabledMcpjsonServers": ["gitnexus"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/run-format-from-root.sh"
          }
        ]
      }
    ]
  }
}
