{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(*)",
      "WebSearch",
      "WebFetch",
      "mcp__webstorm",
      "mcp__xcode",
      "mcp__plugin_playwright_playwright"
    ],
    "deny": [
      "mcp__webstorm__execute_terminal_command",
      "mcp__webstorm__execute_run_configuration",
      "mcp__webstorm__execute_tool",
      "mcp__webstorm__run_inspection_kts",
      "mcp__webstorm__build_project",
      "mcp__webstorm__apply_patch",
      "mcp__webstorm__create_new_file",
      "mcp__webstorm__reformat_file",
      "mcp__xcode__RunCodeSnippet",
      "mcp__xcode__InvokeDebuggerCommand",
      "Bash(git reset --hard:*)",
      "Bash(git checkout --:*)",
      "Bash(rm -rf:*)",
      "Bash(npm run deploy:*)",
      "Bash(npm run migrate:*)",
      "Bash(npm run discover:*)",
      "Bash(npm run add-url:*)",
      "Bash(npm run repair:*)",
      "Bash(npm run validity-check:*)",
      "Bash(npm run embed:*)",
      "Bash(npm run re-embed:*)",
      "Bash(psql:*)",
      "Bash(ssh root@fsd.snowmonkey.co.uk:*)",
      "Bash(docker compose -f docker-compose.production.yml:*)"
    ]
  },
  "sandbox": {
    "enabled": false
  },
  "env": {
    "NODE_USE_ENV_PROXY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "enabledPlugins": {
    "task-files@npomfret": true,
    "webstorm@npomfret": true,
    "web-factoring@npomfret": true,
    "frontend-design@claude-plugins-official": true,
    "database@npomfret": true,
    "auditing@npomfret": true,
    "apple-hig@npomfret": false,
    "typesafe@typesafe-ai": true,
    "typescript-lsp@claude-plugins-official": false,
    "browser-testing@npomfret": true,
    "coding@npomfret": true,
    "http@npomfret": true,
    "ios-ui-testing@npomfret": false,
    "scripting@npomfret": true,
    "teamcity@npomfret": false,
    "testing@npomfret": true,
    "ui@npomfret": true,
    "workflow@npomfret": true,
    "playwright@claude-plugins-official": true,
    "browser@npomfret": true,
    "localization@npomfret": false
  },
  "enabledMcpjsonServers": ["webstorm"],
  "extraKnownMarketplaces": {
    "npomfret": {
      "source": {
        "source": "github",
        "repo": "npomfret/agent-standards"
      },
      "autoUpdate": true
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/run-format-from-root.sh"
          }
        ]
      }
    ]
  }
}
